#!/bin/sh
set -eu

launcher_dir=${0%/*}
if [ "$launcher_dir" = "$0" ]; then
  launcher_dir=.
fi
root=$(CDPATH= cd -- "$launcher_dir" && pwd)

if ! command -v bun >/dev/null 2>&1; then
  echo "rossovia: Bun is required to run the Workbench from this source checkout" >&2
  exit 127
fi

exec bun "$root/src/cli.ts" "$@"
